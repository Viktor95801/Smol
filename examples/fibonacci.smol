let nterms := 10;

let n1 := 0;
let n2 := 1;

print "The fibonacci sequence, for", nterms, "terms, is: ";
print n1, n2;

let i := 2;
while i < nterms {
    let next := n1 + n2;
    if i == nterms - 1 {
        print next;
    } else {
        print next;
    }

    n1 = n2;
    n2 = next;
    i = i + 1;
}
println;
